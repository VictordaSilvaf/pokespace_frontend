VITE_APP_TITLE=Pokespace
VITE_SENTRY_DSN=
# true = demo login without Nest (any trainer/password)
VITE_AUTH_MOCK=false

# Leave empty to use the same-origin /api/v1 proxy.
# Set only if the Nest API allows CORS for this origin.
VITE_API_URL=

# Optional Socket.IO origin for the world namespace (defaults from API/origin).
# VITE_WS_URL=http://localhost:3000

# Nest backend origin used by the Vite proxy, SSR proxy, and health check.
# Local: http://localhost:3000
# Production: https://pokenaut.victorsf.com
API_URL=http://localhost:3000
