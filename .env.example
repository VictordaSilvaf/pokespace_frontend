VITE_APP_TITLE=Pokespace
VITE_SENTRY_DSN=
# true = demo login without Nest (any trainer/password)
VITE_AUTH_MOCK=false

# Leave empty to use the same-origin /api/v1 proxy.
# Set only if the Nest API allows CORS for this origin.
VITE_API_URL=

# Public CDN for sprites (R2 custom domain, or Nest /cdn).
# Registry paths are joined as `{VITE_ASSETS_BASE_URL}/sprites/creature/{id}.png`.
# If unset, falls back to local `/assets/...` (dev extract only; PNGs are gitignored).
# VITE_ASSETS_BASE_URL=https://assets.pokenaut.victorsf.com

# Temporary white empty map for sprite/movement tests (starter.tmx preserved).
# VITE_BLANK_WORLD=true

# Optional Socket.IO origin for the world namespace (defaults from API/origin).
# VITE_WS_URL=http://localhost:3000

# Nest backend origin used by the Vite proxy, SSR proxy, and health check.
# Local: http://localhost:3000
# Production: https://pokenaut.victorsf.com
API_URL=http://localhost:3000
